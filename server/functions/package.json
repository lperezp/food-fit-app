{
  "name": "food-fit-functions",
  "description": "Food Fit is an application designed to generate healthy recipes using Genkit with Vertex AI.",
  "author": "Luis Eduardo <lperezp.dev>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "genkit:dev": "genkit start -- npm run dev",
    "dev": "tsx --watch src/index.local.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/a2ui": "^0.5.0",
    "@genkit-ai/dotprompt": "^0.9.12",
    "@genkit-ai/firebase": "^1.42.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "@genkit-ai/googleai": "^1.28.0",
    "@genkit-ai/vertexai": "^1.42.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.42.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase-functions-test": "^3.5.0",
    "genkit-cli": "^1.42.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": false
}
