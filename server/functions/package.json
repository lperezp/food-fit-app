{
  "name": "food-fit-functions",
  "description": "Food Fit is an application designed to generate healthy recipes using Genkit with Vertex AI.",
  "author": "Luis Eduardo <lperezp.dev>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "genkit:dev": "genkit start -- npm run dev",
    "dev": "tsx --watch src/index.local.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/dotprompt": "^0.9.12",
    "@genkit-ai/firebase": "^1.24.0",
    "@genkit-ai/google-genai": "^1.24.0",
    "@genkit-ai/googleai": "^1.24.0",
    "@genkit-ai/vertexai": "^1.24.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "genkit": "^1.24.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "genkit-cli": "^1.24.0",
    "tsx": "^4.19.2",
    "typescript": "^4.9.5"
  },
  "private": false
}
